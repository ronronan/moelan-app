# Optional reverse proxy putting the whole app under one hostname —
# simplifies CORS/redirect-URI config once this leaves localhost, and
# gets automatic HTTPS for free on a real domain.
#
# Local testing keeps the "http://" scheme so Caddy never attempts ACME
# against "localhost". Deploying to a real domain: drop "http://" (or set
# MOELAN_DOMAIN to the bare domain) so Caddy issues a real certificate,
# and update KC_HOSTNAME / PUBLIC_API_BASE_URL / PUBLIC_KEYCLOAK_ISSUER_URL
# in .env to match — see README's "Production deployment" section.
http://{$MOELAN_DOMAIN:localhost} {
    handle /realms/* {
        reverse_proxy keycloak:8080
    }
    handle /resources/* {
        reverse_proxy keycloak:8080
    }
    handle /admin/* {
        reverse_proxy keycloak:8080
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy web:80
    }
}
