# Postgres
POSTGRES_USER=moelan
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend API (uses the `app` database on the same Postgres instance)
DATABASE_URL=postgres://moelan:changeme@localhost:5432/app
BIND_ADDR=0.0.0.0:8000
RUST_LOG=info

# Keycloak
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=changeme
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/moelan
KEYCLOAK_AUDIENCE=moelan-api
KEYCLOAK_REALM=moelan

# Confidential client with a service account (realm-admin) the backend uses
# to call Keycloak's Admin REST API — creating a new space's groups, and
# creating a Keycloak login when a player is invited. The realm import
# already creates the `moelan-api-service` client; only the secret has to
# be copied over from Keycloak (Clients > moelan-api-service > Credentials)
# after the first `docker compose up`.
KEYCLOAK_SERVICE_CLIENT_ID=moelan-api-service
KEYCLOAK_SERVICE_CLIENT_SECRET=

# Generic SMTP relay for debt-alert emails (a player's balance crossing an
# org's configured threshold). Works with any provider that exposes plain
# SMTP — Mailgun, Brevo, SendGrid, etc — so there's no vendor SDK to pick.
# Leave SMTP_HOST empty to run without email (alerts are just logged).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Flutter web build (baked in at build time, only used by `docker compose
# build web` / `up --build`). Defaults are correct for localhost; for a
# real deployment set these to wherever the browser can reach the API and
# Keycloak. PUBLIC_API_BASE_URL is the bare origin *without* /api — every
# request already adds that prefix itself, e.g. https://moelan.example.com
# (not .../api) and https://moelan.example.com/realms/moelan — see
# README's "Production deployment" section.
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/moelan
